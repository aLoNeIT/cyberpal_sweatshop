# pi-agent 平台 Docker Compose 环境变量
# 复制此文件为 .env 并修改

# ===== Nginx =====
NGINX_PORT=80

# ===== pi-gateway =====
GATEWAY_PORT=3002
GATEWAY_JWT_SECRET=change-me-to-a-random-string-32chars
LOG_LEVEL=info

# ===== Hyperf =====
APP_ENV=dev
SCAN_CACHEABLE=false
PI_GATEWAY_SERVICE_ID=hyperf
PI_GATEWAY_WS_URL=ws://pi-gateway:3002

# ===== Pi Agent =====
PI_AGENT_PROVIDER=openai
PI_AGENT_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-key-here

# ===== Agent 生命周期 =====
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_TIMEOUT_MS=30000
SESSION_TIMEOUT_MS=1800000
AGENT_IDLE_TIMEOUT_MS=600000
CLEANUP_INTERVAL_MS=60000

# ===== 沙箱 =====
PI_SANDBOX=gondolin
